# AI Apps Live — Environment Configuration

# Required: Operator password hash generated via `npm run admin:hash`
ADMIN_PASSWORD_HASH=

# Required: Contact info placed in HTTP User-Agent header for collectors (e.g., admin@example.com)
OPERATOR_CONTACT=operator@localhost

# Path to SQLite database file (defaults to data/ai-apps-live.db)
DATABASE_PATH=data/ai-apps-live.db

# Demo mode: set to 1 to run isolated demo DB and paint "DEMO DATA — NOT REAL" watermark
DEMO_MODE=0

# Days to retain full raw gzip response bodies in source_observations before pruning (default: 180)
RAW_RETENTION_DAYS=180

# Display timezone for broadcast and UI timestamps (default: UTC)
DISPLAY_TZ=UTC

# Optional: Cloudflare Radar API token (for optional DNS Popularity module)
CLOUDFLARE_RADAR_TOKEN=

# Network binding
HOST=127.0.0.1
PORT=3000
