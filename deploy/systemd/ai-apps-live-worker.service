[Unit]
Description=AI Apps Live - Ingestion & Polling Worker
Documentation=file://%h/ai-apps-live/docs/OPERATIONS.md
After=network.target ai-apps-live-web.service

[Service]
Type=simple
WorkingDirectory=%h/ai-apps-live
EnvironmentFile=%h/ai-apps-live/.env
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-apps-live-worker

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=%h/ai-apps-live/data

[Install]
WantedBy=default.target
